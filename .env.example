# ===== サイト公開URL（SEO用・任意） =====
# Vercel デプロイ後に本番URLを設定すると、OGP・サイトマップ・構造化データに反映されます。
# 例: https://est-learning-platform.vercel.app
NEXT_PUBLIC_SITE_URL=""

# ===== コラム（microCMS）=====
# 設定するとコラム記事を microCMS から取得します（管理画面でブラウザ執筆・投稿が可能に）。
# 未設定の場合は content/blog/*.md（Markdownファイル）から取得します。
# 設定手順は docs/microcms-setup.md を参照してください。
MICROCMS_SERVICE_DOMAIN=""   # 例: your-service（https://your-service.microcms.io の your-service 部分）
MICROCMS_API_KEY=""          # microCMS の API キー
MICROCMS_BLOG_ENDPOINT="blog" # ブログAPIのエンドポイント名（既定: blog）

# ===== コース（microCMS）=====
# 設定するとコース情報（サムネイル画像含む）を microCMS から取得します。
# 未設定の場合はサンプルコースのみで動作します。
# 設定手順は docs/microcms-courses-setup.md を参照してください。
# サービスドメイン・APIキーはコラムと共通（上記の MICROCMS_SERVICE_DOMAIN / MICROCMS_API_KEY を使用）
MICROCMS_COURSE_ENDPOINT="course" # コースAPIのエンドポイント名（既定: course）

# ===== 設計書 10. 環境変数一覧 =====
# 本デモはモックデータで動作するため、これらの設定は不要です。
# 本番（Prisma/NextAuth/Stripe/Cloudinary）移行時に設定してください。

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/est_learning"

# NextAuth (Auth.js v5)
NEXTAUTH_SECRET="openssl rand -base64 32 で生成"
NEXTAUTH_URL="https://learn.est.co.jp"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend)
RESEND_API_KEY=""

# Leads (会員登録フォームの送信先)
LEADS_WEBHOOK_URL="" # クライアントの外部DB/CRMが受け取るWebhook URL。未設定の間は data/leads.json に保存

# Redis (Upstash)
REDIS_URL=""
